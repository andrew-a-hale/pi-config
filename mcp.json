{
  "mcpServers": {
    "duckdb": {
      "command": "uvx",
      "args": [
        "mcp-server-motherduck",
        "--db-path",
        ":memory:",
        "--read-write"
      ],
      "description": "DuckDB in-memory SQL analytics (mcp-server-motherduck)"
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "brave-search-mcp"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "description": "Brave web search"
    },
    "chrome-devtools-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp",
        "-u",
        "http://127.0.0.1:9222"
      ],
      "description": "Chrome DevTools browser automation on :9222"
    }
  }
}
